# Public browser configuration (safe to expose; these are not secret keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# FASHN_API_KEY belongs in Supabase Edge Function secrets only.
# Never add it to NEXT_PUBLIC_* variables or commit it to GitHub.
